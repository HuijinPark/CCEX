{
    # The Hahn-echo coherence of an NV centre in diamond with natural-abundance 13C (1.1 %): conventional CCE to
    # order 2, the bath in its unpolarised (ensemble) state. Every key not written here has its default; `main.out -e`
    # writes an input with all of them.
    "Qubit"         : {"file": "bath/bath_Diamond_NV_natab_defect"},    # the NV position (spin 1, ms +1 / 0 by default)
    "configuration" : {"gyrofile": "bath/gyro_13C", "bathfile": ["bath/bath_Diamond_NV_natab_1"]},
    "order"         : 2,        # clusters of up to two 13C
    "bfield"        : 500,      # G, along z (the NV axis)
    "rbath"         : 50,       # A: the 13C within 50 A of the NV
    "rdip"          : 10,       # A: two 13C closer than this form a pair cluster
    "deltat"        : 0.001,    # ms
    "nstep"         : 2000,     # 2000 x 1 us = 2 ms
    "pulse"         : {"count": 1}    # one pi pulse: the Hahn echo
}
