{
    // 00_quickstart's NV and bath with the bath in 20 sampled product states instead of the ensemble: s_range [1, 20] draws
    // them from seed (outputs ccein_state1_wiDiv ... ccein_state20_wiDiv); their mean approaches the ensemble curve.
    // Sampled bath states: configuration.s_range [1, 20], each state s its own output _state<s>.
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"],
                       "s_range" : [1, 20],
                       "seed"    : 1},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1}
}
