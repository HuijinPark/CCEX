{
    // ccein.jsonc with the 20 bath states read from files instead of drawn by CCEX: run.sh writes them first with
    // example/tools/StateFiles/make_state_files.py (results/states/state1 ... state20, {s} the state; m_s uniform over
    // the 2I+1 levels, numpy default_rng([seed, k, s])). Every file of s_range has to be there.
    // Sampled bath states: configuration.s_range [1, 20], each state s its own output _state<s>.
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"],
                       "s_range" : [1, 20],
                       "bath_state_file": ["results/states/state{s}"],
                       "seed"    : 1},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1}
}
