{
    // 00_quickstart's NV, averaged over four bath configurations. configuration.k_range runs one calculation per k
    // with {k} replaced in the file names (outputs ccein_k1_wiDiv ... ccein_k4_wiDiv); run.sh makes the four files.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "results/bath/config_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["results/bath/config_{k}"],
                       "k_range" : [1, 4]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1}
}
