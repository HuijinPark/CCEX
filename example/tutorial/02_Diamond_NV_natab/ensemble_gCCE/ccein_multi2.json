{
    # Config (General)
    "method"        : "gCCE",
    "quantity"      : "coherence",
    "gyrofile"      : "../bath/gyro_13C",
    "bathfile"      : ["../bath/bath_Diamond_NV_natab_1"],
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,

    # Qubit: two NV centres, both along z. qubit1 is the NV of ccein_single.json (the position in
    # ../bath/bath_Diamond_NV_natab_defect), qubit2 25 A above it, so that rbath 50 around each stays
    # inside the 150 A bath cell. The coherence is between |+1,+1> and |0,0>; the two NVs interact by
    # their dipolar coupling (set from the positions).
    "Qubit"   : {
                   "nqubit" : 2,
                   "qubit"  : [{
                                    "name"   : "qubit1",
                                    "spin"   : 1.0,
                                    "gyro"   : -17608.597050,
                                    "xyz"    :  [  73.73895,	  75.72808,	  73.97033],
                                    "alphams": 1,
                                    "betams" : 0,
                                    "detuning": [0.0]
                              },
                              {
                                    "name"   : "qubit2",
                                    "spin"   : 1.0,
                                    "gyro"   : -17608.597050,
                                    "xyz"    :  [  73.73895,	  75.72808,	  98.97033],
                                    "alphams": 1,
                                    "betams" : 0,
                                    "detuning": [0.0]
                              }
                   ],
        			"intmap": [{
        			                "between": ["qubit1", "qubit1"],
        			                "tensor" : [[-960000, 0, 0],[0, -960000, 0 ],[0, 0, 1920000]]
        			           },
                               {
        			                "between": ["qubit2", "qubit2"],
        			                "tensor" : [[-960000, 0, 0],[0, -960000, 0 ],[0, 0, 1920000]]
        			           }
                    ]
                },

    # Pulse
    "npulse"      : 1,

    # Output
    "outfile"     : "./results/CCE2_Diamond_NV_natab_1"

}
