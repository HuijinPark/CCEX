{
    # Config (General)
    "method"        : "CCE", 
    "quantity"      : "coherence",
    "qubitfile"     : "../bath/bath_Diamond_NV_natab_defect",
    # gyrofile left out : every bath species is taken from the built-in isotope table (src/input/isotope_table.cpp,
    #                     EasySpin isotopes, gamma = g_n mu_N / hbar): here 13C, spin 1/2, 6.72828544 rad/ms/G against
    #                     6.728284 in ../bath/gyro_13C. Species that are not isotopes (P1, Vp, ...) still need a gyrofile.
    "bathfile"      : ["../bath/bath_Diamond_NV_natab_1"],
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,

    # Qubit 
    "qalphams"     : 1,
    "qbetams"      : 0,

    # Pulse
    "npulse"      : 1,

    # Output
    "outfile"     : "./results/CCE2_builtin_1"

}
