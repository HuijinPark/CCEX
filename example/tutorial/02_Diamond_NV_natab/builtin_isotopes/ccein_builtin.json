    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,

    # Pulse
    "pulse"         : {"count": 1},

    # Output
    "outfile"     : "./results/CCE2_builtin_1"

}
