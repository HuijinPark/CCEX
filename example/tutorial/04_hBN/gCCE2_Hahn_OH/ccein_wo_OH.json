{
    # V_B- in h-BN at zero field, gCCE2 Hahn echo between the ms = +-1 superposition and ms = 0, one sampled bath
    # state, without the Overhauser field.
    "method"        : "gCCE",
    "Qubit"         : {"qubit"      : [{"name": "VB", "xyz": [33.94003, 45.72817, 7.50000]}],
                       "intmap"     : [{"between": ["VB", "VB"], "tensor": [[-1080, 0, 0], [0, -1180, 0], [0, 0, 2320]], "unit": "MHz"}],
                       "alpha_state": {"vector": [1, 0, 1]},     # the superposition of ms +1 and -1 (normalised by the code)
                       "beta_state" : {"vector": [0, 1, 0]}},    # ms 0
    "configuration" : {"gyrofile": "../bath/hBN_natab_gyro",
                       "bathfile": ["../bath/flat/bath_hBN_VB_flat_1"],
                       "nstate"  : 1,
                       "seed"    : 8805},
    "order"         : 2,
    "bfield"        : 0,
    "rbath"         : 14,
    "rdip"          : 8,
    "deltat"        : 0.00000001,
    "nstep"         : 50,
    "pulse"         : {"count": 1},
    "hamiltonian"   : {"common": {
            "qubit_bath_mean_field" : false,
            "hyperfine"  : {"dipole": "dft", "contact": true,         # the DFT hyperfine tensors (dipolar and contact)
                            "file": "../bath/flat/hBN_VB_flat_ATensor_HSE_CellPBE_v3"},
            "quadrupole" : {"structure": "plain",                     # the DFT electric-field gradients of the 11B, 10B, 14N
                            "file": "../bath/flat/hBN_VB_flat_QTensor_HSE_CellPBE"}
        }}
}
