{
    // V_B- in hexagonal BN (spin 1) with natural-abundance 10B, 11B, 14N at 3 T, cCCE2 Hahn echo of the ensemble over
    // five bath configurations (k_range), with the hyperfine tensors only (no quadrupole).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../bath/flat/bath_hBN_VB_flat_Defect"}]},
    "configuration" : {"gyrofile": "../bath/hBN_natab_gyro",
                       "bathfile": ["../bath/flat/bath_hBN_VB_flat_{k}"],
                       "k_range" : [1, 5]},
    "order"         : 2,
    "bfield"        : 30000,
    "rbath"         : 20,
    "rdip"          : 10,
    "deltat"        : 0.003,
    "nstep"         : 50,
    "pulse"         : {"count": 1},
    "hamiltonian"   : {"common": {
            "hyperfine"  : {"dipole": "dft", "contact": true,         // the DFT hyperfine tensors (dipolar and contact)
                            "file": "../bath/flat/hBN_VB_flat_ATensor_HSE_CellPBE_v3"}
        }}
}
