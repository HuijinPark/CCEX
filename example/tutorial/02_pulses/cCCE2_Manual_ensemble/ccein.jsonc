{
    // CPMG-2 written out as a Manual sequence: one row [fraction of the total time before the pulse, axis, angle in
    // degrees] per pulse and a last row for the free evolution after it (count + 1 rows; the fractions sum to 1).
    // run.sh compares it with the built-in CPMG-2 (pulse.count 2 without name and sequence).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.002,
    "nstep"         : 2000,
    "pulse"         : {"count": 2, "name": "Manual",
                       "sequence": [["1/4", "X", 180.0], ["1/2", "X", 180.0], ["1/4", "I", 0.0]]}
}
