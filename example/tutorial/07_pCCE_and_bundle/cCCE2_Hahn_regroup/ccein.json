{
    # The NV in six P1 electron spins (bath/bath_p1_6), five sampled states, bundles of up to dimension 4, and the
    # adaptive refinement with regroup: bundles whose states give |L| > 1 are split or joined until every state is
    # physical. The NV position and the P1 gyromagnetic ratio are 08_GPU's.
    "Qubit"         : {"file": "../../08_GPU/bath/qubit_p1", "alphams": -1},
    "configuration" : {"gyrofile": "../../08_GPU/bath/gyro_P1",
                       "bathfile": ["../bath/bath_p1_6"],
                       "nstate"  : 5,
                       "seed"    : 1},
    "order"         : 2,
    "bfield"        : 292,
    "rbath"         : 38,
    "rdip"          : 100,
    "deltat"        : 0.0005,
    "nstep"         : 30,
    "pulse"         : {"count": 1},
    # P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings (MHz),
    # one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]},
    "cluster"       : {"mode": "bundle", "bundle": {"max_dim": 4},
                       "adaptive": {"output": "./results/adaptive", "atol": 1e-3, "rtol": 0, "regroup": true}}
}
