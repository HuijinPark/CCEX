{
    // cCCE2_Hahn_bundle (rbath 20, 2 ms) with adaptive refinement: the bundled calculation is repeated, the error at
    // the bundle boundaries measured, and bundles merged (policy merge) until the curve moves by less than atol.
    // adaptive needs an explicit seed: every round recomputes the same system. The steps go to results/adaptive/.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"],
                       "seed"    : 9407},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 20,
    "rdip"          : 10,
    "deltat"        : 0.01,
    "nstep"         : 200,
    "pulse"         : {"count": 1},
    "cluster"       : {"mode": "bundle", "bundle": {"max_dim": 8},
                       "adaptive": {"workdir": "./results/adaptive", "atol": 1e-3, "rtol": 0, "max_rounds": 4}}
}
