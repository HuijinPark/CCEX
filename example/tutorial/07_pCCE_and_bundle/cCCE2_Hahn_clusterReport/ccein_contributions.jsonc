{
    // 00_quickstart's input with a table of what every cluster contributes (output.cluster_contributions):
    // results/ccein_contributions.contributions.state-0.tsv, one row per cluster (its sites, dimension, the largest
    // |log L~| over the time points, ...), and ccein_contributions.contributions.sites.tsv (each site's name, spin,
    // gyromagnetic ratio and position). savemode's nodiv false writes _wiDiv alone (no _noDiv).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1},
    "output"        : {"cluster_contributions": {"enabled": true},
                       "savemode"             : {"mode": "coherence", "nodiv": false}}
}
