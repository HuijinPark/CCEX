{
    // 00_quickstart's input with output.cluster_only true: the run makes the clusters, writes them to
    // results/ccein_plan.clusters.json and stops before the dynamics (no coherence is computed), to see how many
    // clusters an rbath and rdip give before a long run.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1},
    "output"        : {"cluster_only": true}
}
