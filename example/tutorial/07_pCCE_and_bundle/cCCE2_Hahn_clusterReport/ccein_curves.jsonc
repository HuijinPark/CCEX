{
    // 00_quickstart's input cut to the 13C within 15 A (rbath), with output.savemode cluster_coherence: beside the
    // result, the coherence of every cluster, results/ccein_curves_<bath indices>_wiDiv and _noDiv (one pair of files
    // per cluster, so only for a small bath).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 15,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1},
    "output"        : {"savemode": "cluster_coherence"}
}
