#!/bin/bash
#SBATCH -J CCE2_Diamond_NV_natab
#SBATCH -p 64core
#SBATCH --nodes=2
#SBATCH --ntasks-per-node=64
#SBATCH --cpus-per-task=1
#SBATCH --out outfile
#SBATCH --time=2-00:00:00
#SBATCH --qos=small-2
#SBATCH --mem-per-cpu=0
# 06_Pulse_Manual/WAHUHA_natab_single_ccce on idm: runs this folder's run.sh with the job's ranks and the recorded number of
# configurations (and sampled states), so a submitted run and a run by hand are the same calculation.
# Submit with: QosChange job 1 && SbatchPath job
cd "$SLURM_SUBMIT_DIR"
NP=$SLURM_NTASKS NCONF=1 bash run.sh
