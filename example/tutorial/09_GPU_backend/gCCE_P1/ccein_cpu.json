    #           dimension 768 (GPU under auto); the clusters of three have 192 (CPU under auto)
    "backend"        : "cpu",
    "gpu_options"    : {"min_dim": 256, "evolution_batch_steps": 64},
    # profile : timings per rank, method, backend and Hilbert dimension in the process file
    "profile"        : true,

