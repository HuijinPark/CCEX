    },
    "npulse"        : 1,
    "nstate"        : 0,
    "seed"          : 1,

    # Backend : "cpu" (default), "auto" (CUDA for every cluster whose dimension is at least
    #           gpu_options.min_dim, CPU for the rest; CPU everywhere in a CPU-only binary) or "cuda"
