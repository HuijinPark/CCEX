{
    // 00_quickstart's NV (with its zero-field splitting, kHz) in a field tilted from the NV axis ([50, 0, 100] G),
    // cCCE2, with the Knight shift (hamiltonian.cCCE.knight): the qubit's transverse field mixes its levels, which shifts the 13C precession.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "Qubit"         : {"qubit": [{"file": "../../00_quickstart/bath/bath_Diamond_NV_natab_defect"}],
                       "intmap" : [{"between": ["q0", "q0"], "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]], "unit": "kHz"}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
    "order"         : 2,
    "bfield"        : [50, 0, 100],
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1},
    "hamiltonian"   : {"cCCE": {"knight": true}}
}
