{
    // Config (General) : the physics only, as in ../cCCE2_Hahn_ensemble. rbath, rdip and the time window are not
    //                    given: the auto_convergence block finds them. nstep is the number of time points of
    //                    every run; deltat only sets the first window ((nstep - 1) x deltat = 1 ms).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "method"           : "cCCE",
    "quantity"         : "coherence",
    // Qubit : ms = +1 / 0 of the NV, one pi pulse (Hahn echo)
    "Qubit"            : {"qubit": [{"file": "results/bath/config_defect"}], "alpha_state": {"ms": [1]}, "beta_state": {"ms": [0]}},
    "configuration"    : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
        // no s_range : the ensemble, one curve per bath configuration; only the number of configurations is chosen
        "seed"     : 1,
        "bathfile" : ["results/bath/config_{k}"]},
    "order"            : 2,
    "bfield"           : 500,
    "deltat"           : 0.01,
    "nstep"            : 101,
    "pulse"            : {"count": 1},

    // auto_convergence : the block of ../cCCE2_Hahn_ensemble without rdip and rbath: only the workdir and the
    //                    sampling are written (example/tools/AutoConvergence/README.md).
    //   sampling       : the split of the bath configurations, as in ../cCCE2_Hahn_ensemble (10 for the tests).
    //   rdip, rbath    : left out: the runner counts the 13C of the test configurations around the NV and starts
    //                    from 4 rbath candidates 1.25 apart, the largest where 300 spins are inside, and 7 rdip
    //                    candidates 0.8 apart from the pair-phase rule; the largest of each is raised by 1.25
    //                    until the comparisons agree (rbath at most the 68 A the 140 A cells of run.sh cover;
    //                    the 110 A cells of ../cCCE2_Hahn_ensemble, 53 A, stop it unresolved: it needs 65.5 A).
    "auto_convergence" : {
        "workdir"        : "results/auto",
        "sampling"       : {}
    }
}
