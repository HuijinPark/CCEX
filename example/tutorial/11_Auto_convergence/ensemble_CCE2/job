#!/bin/bash
#SBATCH -J CCE2_auto_convergence
#SBATCH -p 64core
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=4
#SBATCH --cpus-per-task=1
#SBATCH --out outfile
#SBATCH --time=01:00:00
#SBATCH --qos=small-2
#SBATCH --mem-per-cpu=0
# 11_Auto_convergence/ensemble_CCE2 on idm: runs this folder's run.sh with the job's ranks and the recorded number of
# bath configurations (NBATH), so a submitted run and a run by hand are the same calculation. The runner needs
# python3 >= 3.10 with numpy, scipy and matplotlib (CCEX_PYTHON picks the interpreter). Sized like the recorded run
# (4 ranks, about 4 min on WSL; the baths are made one at a time by python3, so more ranks do not help much).
# Submit with: QosChange job 1 && SbatchPath job
cd "$SLURM_SUBMIT_DIR"
NP=$SLURM_NTASKS NBATH=40 bash run.sh
