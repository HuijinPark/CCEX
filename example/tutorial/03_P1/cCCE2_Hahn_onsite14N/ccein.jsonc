{
    // cCCE2_Hahn_states with the 14N of every P1 as a spin of its own (the cluster of a P1 is its electron and its 14N).
    // Sampled bath states: configuration.s_range [1, 10], each state s its own output _state<s>.
    "Qubit"         : {"qubit": [{"file": "../bath/14N_1ppm/bath_DiaP1_1ppm_Defect"}], "alpha_state": {"ms": [-1]}},    // ms -1 / 0
    "configuration" : {"gyrofile": "../bath/DiaP1_gyro",
                       "bathfile": ["../bath/14N_1ppm/bath_DiaP1_1ppm_{k}"],
                       "k_range" : [1, 2],
                       "s_range" : [1, 10],
                       "seed"    : [1, 1]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 850,
    "rdip"          : 620,
    "deltat"        : 0.01,
    "nstep"         : 300,
    "pulse"         : {"count": 1},
    // P1 with its 14N written as an on-site nuclear spin (n_onsite_spins 1): four Jahn-Teller axes, the 14N hyperfine
    // (MHz) and electric-field gradient (atomic units) per axis; the electron and its 14N then enter the clusters together
    "Defect"        : {"species": [{
        "name"               : "P1",
        "n_onsite_spins"     : 1,
        "types"              : ["14N"],
        "spins"              : [1],
        "quadrupole_moments" : [2.044],
        "gyros"              : [1.9337792],
        "n_axis_states"      : 4,
        "hyperfine"          : [[1, "14N", [ 81.312000,   0.000000,   0.000000,   0.000000,  81.312000,   0.000000,   0.000000,   0.000000, 114.026400]],
                                [2, "14N", [103.121928,  12.591967,   8.903264,  12.591967,  88.581975,   5.140302,   8.903264,   5.140302,  84.946496]],
                                [3, "14N", [103.121923, -12.591970,  -8.903263, -12.591970,  88.581981,   5.140303,  -8.903263,   5.140303,  84.946496]],
                                [4, "14N", [ 81.312000,  -0.000001,   0.000000,  -0.000001, 110.391904, -10.280603,   0.000000, -10.280603,  84.946496]]],
        "efg"                : [[1, "14N", [  0.521910,   0.000000,   0.000000,   0.000000,   0.522771,  -0.000086,   0.000000,  -0.000086,  -1.044681]],
                                [2, "14N", [ -0.522214,  -0.603404,  -0.426335,  -0.603404,   0.174349,  -0.246178,  -0.426335,  -0.246178,   0.347865]],
                                [3, "14N", [ -0.522354,   0.603323,   0.426364,   0.603323,   0.174489,  -0.246128,   0.426364,  -0.246128,   0.347865]],
                                [4, "14N", [  0.522771,   0.000081,  -0.000029,   0.000081,  -0.870636,   0.492306,  -0.000029,   0.492306,   0.347865]]]}]}
}
