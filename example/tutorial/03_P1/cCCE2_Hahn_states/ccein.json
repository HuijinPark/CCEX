{
    # The Hahn echo of an NV in a 1 ppm P1 electron-spin bath, cCCE2: two bath configurations (k_range) with ten
    # sampled bath states each (nstate; the P1 axes and spin states drawn from seed).
    "Qubit"         : {"file": "../bath/14N_1ppm/bath_DiaP1_1ppm_Defect", "alphams": -1},    # ms -1 / 0
    "configuration" : {"gyrofile": "../bath/DiaP1_gyro",
                       "bathfile": ["../bath/14N_1ppm/bath_DiaP1_1ppm_{k}"],
                       "k_range" : [1, 2],
                       "nstate"  : 10,
                       "seed"    : 1},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 850,
    "rdip"          : 620,
    "deltat"        : 0.01,
    "nstep"         : 300,
    "pulse"         : {"count": 1},
    # P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings (MHz),
    # one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
}
