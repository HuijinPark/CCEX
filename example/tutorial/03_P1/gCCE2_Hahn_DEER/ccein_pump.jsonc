{
    // The Hahn echo of the NV (ms +1 / 0) in a 1 ppm P1 bath, gCCE2, with a DEER pump: a pi pulse on the P1 spins at
    // the time of the NV's pi pulse (pulse.bath). It drives only the P1 whose detuning lies within pulse.bath.bandwidth
    // of the tone (energy_shift 0 MHz: the central 14N line, axis states 4, 5, 6 and 11 below), so their coupling to the
    // NV is no longer refocused by the echo.
    // Sampled bath states: configuration.s_range [1, 10], each state s its own output _state<s>.
    "method"        : "gCCE",
    "Qubit"         : {"qubit" : [{"name": "NV", "xyz": [1123.596, 1124.863, 1124.378]}],
                       "alpha_state" : {"ms": [1]},
                       "beta_state" : {"ms": [0]},
                       "intmap": [{"between": ["NV", "NV"], "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]}]},
    "configuration" : {"gyrofile": "../bath/DiaP1_gyro",
                       "bathfile": ["../bath/14N_1ppm/bath_DiaP1_1ppm_1"],
                       "s_range" : [1, 10],
                       "seed"    : 1},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 850,
    "rdip"          : 620,
    "deltat"        : 0.002,
    "nstep"         : 200,
    "pulse"         : {"count": 1,
                       "bath" : {"count"       : 1,
                                 "defect"      : "P1",
                                 "energy_shift": [0.0],
                                 "sequence"    : [["1/2", "X", 180.0], ["1/2", "I", 0.0]]}},
    // P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings (MHz),
    // one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
}
