{
    // The Hahn echo of the NV (ms -1 / 0) in 1 ppm P1, cCCE2, ten sampled bath states: every cluster feels the static
    // field of the bath spins outside it, from their sampled states (hamiltonian.common.bath_bath_mean_field).
    // This input: "z", its z part (the default). ccein_off.jsonc leaves it out, ccein_xyz.jsonc adds the x and y parts.
    // Sampled bath states: configuration.s_range [1, 10], each state s its own output _state<s>.
    "Qubit"         : {"qubit": [{"file": "../bath/14N_1ppm/bath_DiaP1_1ppm_Defect"}], "alpha_state": {"ms": [-1]}},    // ms -1 / 0
    "configuration" : {"gyrofile": "../bath/DiaP1_gyro",
                       "bathfile": ["../bath/14N_1ppm/bath_DiaP1_1ppm_1"],
                       "s_range" : [1, 10],
                       "seed"    : 1},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 850,
    "rdip"          : 620,
    "deltat"        : 0.01,
    "nstep"         : 300,
    "pulse"         : {"count": 1},
    "hamiltonian"   : {"common": {"bath_bath_mean_field": "z"}},
    // P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings (MHz),
    // one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
}
