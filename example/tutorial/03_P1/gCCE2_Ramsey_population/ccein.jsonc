{
    // The NV prepared in ms = 0 (alpha_state = beta_state = {"ms": [0]}) in a 10 ppm P1 bath at 300 G, no pulse: the qubit density
    // matrix (quantity dm) of gCCE2 over 50 ms, whose ms = 0 population shows the flip-flops with the bath.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "method"        : "gCCE",
    "quantity"      : "dm",
    "Qubit"         : {"qubit" : [{"name": "NV", "xyz": [523.336, 524.936, 521.003]}],
                       "alpha_state" : {"ms": [0]},
                       "beta_state" : {"ms": [0]},
                       "intmap": [{"between": ["NV", "NV"], "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]}]},
    "configuration" : {"gyrofile": "../bath/DiaP1_gyro",
                       "bathfile": ["../bath/14N_10ppm/bath_DiaP1_10ppm_1"],
                       "seed"    : 8805},
    "order"         : 2,
    "bfield"        : 300,
    "rbath"         : 370,
    "rdip"          : 330,
    "deltat"        : 0.01,
    "nstep"         : 5000,
    "pulse"         : {"count": 0},
    // P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings (MHz),
    // one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
}
