{
    // The NV in a 10 ppm P1 bath at zero field, gCCE2 (the NV a spin 1 with its zero-field splitting): one bath
    // configuration and one sampled bath state. ccein_without_ZFS.jsonc is the same without the splitting.
    // Sampled bath states: configuration.s_range [1, 1], each state s its own output _state<s>.
    "method"        : "gCCE",
    "Qubit"         : {"qubit": [{"name": "NV", "xyz": [523.336, 524.936, 521.003]}], "alpha_state": {"ms": [-1]}, "beta_state": {"ms": [0]}},
    "configuration" : {"gyrofile": "../bath/DiaP1_gyro",
                       "bathfile": ["../bath/14N_10ppm/bath_DiaP1_10ppm_1"],
                       "s_range" : [1, 1],
                       "seed"    : 8810},
    "order"         : 2,
    "bfield"        : 0,
    "rbath"         : 370,
    "rdip"          : 330,
    "deltat"        : 5e-05,
    "nstep"         : 100,
    "pulse"         : {"count": 1},
    // P1 (substitutional N): an electron spin 1/2 whose hyperfine with its 14N shifts it by one of these detunings (MHz),
    // one per Jahn-Teller axis and 14N state; each P1 is given one of the 12 at random (from seed)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_axis_states" : 12,
        "detuning"      : [[1, "e",  84.946496], [2, "e",  84.946496], [3,  "e",  84.946496],
                           [4, "e",   0.0],      [5, "e",   0.0],      [6,  "e",   0.0],
                           [7, "e", -84.946496], [8, "e", -84.946496], [9,  "e", -84.946496],
                           [10, "e", 114.0264],  [11, "e",  0.0],      [12, "e", -114.0264]]}]}
}
