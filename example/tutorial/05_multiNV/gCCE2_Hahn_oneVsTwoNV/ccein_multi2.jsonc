{
    // Two NV centres along z in the same bath: qubit1 is the NV of ccein_single.jsonc, qubit2 25 A above it (rbath 50
    // around each stays inside the 150 A bath cell). The coherence is between |+1,+1> and |0,0>; the two NVs interact
    // by their dipolar coupling (set from the positions).
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "method"        : "gCCE",
    "Qubit"         : {"qubit" : [{"name": "qubit1", "xyz": [73.73895, 75.72808, 73.97033]},
                                  {"name": "qubit2", "xyz": [73.73895, 75.72808, 98.97033]}],
                       "intmap": [{"between": ["qubit1", "qubit1"], "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["qubit2", "qubit2"], "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]}]},
    "configuration" : {"gyrofile": "../../00_quickstart/bath/gyro_13C",
                       "bathfile": ["../../00_quickstart/bath/bath_Diamond_NV_natab_1"]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 50,
    "rdip"          : 10,
    "deltat"        : 0.001,
    "nstep"         : 2000,
    "pulse"         : {"count": 1}
}
