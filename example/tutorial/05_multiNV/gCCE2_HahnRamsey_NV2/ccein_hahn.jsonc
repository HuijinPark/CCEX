{
    // 2 NV centres 50 A apart (each a spin 1 with its zero-field splitting, ms +1 / 0) and a pair of 13C between them:
    // the Hahn echo of the 2-qubit density matrix (quantity dm), gCCE2, the bath in the state of the file state1.
    // Sampled bath states: configuration.s_range [1, 1], each state s its own output _state<s>.
    "method"        : "gCCE",
    "quantity"      : "dm",
    "Qubit"         : {"qubit" : [
                                  {"name": "q1", "xyz": [75.663000, 74.262800, 74.134800]},
                                  {"name": "q2", "xyz": [75.663000, 74.262800, 124.134800]}],
                       "intmap": [
                                  {"between": ["q1", "q1"], "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]},
                                  {"between": ["q2", "q2"], "tensor": [[-960000, 0, 0], [0, -960000, 0], [0, 0, 1920000]]}]},
    "configuration" : {"gyrofile": "gyro_13C", "bathfile": ["bath"], "bath_state_file": ["state"], "s_range": [1, 1]},
    "order"         : 2,
    "bfield"        : 500,
    "rbath"         : 10000,
    "rdip"          : 50000,
    "deltat"        : 0.0000001,
    "nstep"         : 300,
    "pulse"         : {"count": 1}
}
