{
    // gCCE4 Hahn echo of the NV (spin 1 with its zero-field splitting) in four P1: the cluster of all four has dimension 768 with the qubit, the ensemble.
    // execution.backend: cpu (the default), auto (CUDA for every cluster of dimension >= gpu_options.min_dim, the CPU for
    // the rest; the CPU everywhere in a binary built without CUDA) or cuda (every cluster; refused without CUDA).
    // run.sh runs this input with each of the three. profile prints the timings per backend and dimension.
    // The ensemble: no configuration.s_range, the average over the unpolarised bath (one output).
    "method"        : "gCCE",
    "Qubit"         : {"qubit" : [{"name": "NV", "xyz": [523.336, 524.936, 521.003]}],
                       "alpha_state" : {"ms": [-1]},
                       "beta_state" : {"ms": [0]},
                       "intmap": [{"between": ["NV", "NV"],
                                   "tensor" : [[-956666.6666666666, 0.0, 0.0], [0.0, -956666.6666666666, 0.0], [0.0, 0.0, 1913333.3333333333]]}]},
    "configuration" : {"gyrofile": "../bath/gyro_P1", "bathfile": ["../bath/bath_p1_4"], "seed": 1},
    "order"         : 4,
    "bfield"        : 292,
    "rbath"         : 58.67823308490217,
    "rdip"          : 117.35646616980434,
    "deltat"        : 0.0003,
    "nstep"         : 100,
    "pulse"         : {"count": 1},
    "execution"     : {"backend": "cpu", "gpu_options": {"min_dim": 256, "evolution_batch_steps": 64}, "profile": true},
    // P1 with its 15N as an on-site nuclear spin; one of four Jahn-Teller axes is drawn per P1 from the seed, each with
    // its own 15N hyperfine tensor (MHz)
    "Defect"        : {"species": [{
        "name"          : "P1",
        "n_onsite_spins": 1,
        "types"         : ["15N"],
        "spins"         : [0.5],
        "gyros"         : [-2.71261804],
        "n_axis_states" : 4,
        "hyperfine"     : [[1, "15N", [-114.060798, 0.0, 0.0, 0.0, -114.060798, 0.0, 0.0, 0.0, -159.951079]],
                           [2, "15N", [-144.654779, -17.663442, -12.489096, -17.663442, -124.25879, -7.210583, -12.489096, -7.210583, -119.159104]],
                           [3, "15N", [-144.654772, 17.663446, 12.489095, 17.663446, -124.258798, -7.210585, 12.489095, -7.210585, -119.159104]],
                           [4, "15N", [-114.060798, 1e-06, 0.0, 1e-06, -154.852772, 14.421165, 0.0, 14.421165, -119.159104]]]}]}
}
