// NV-13C with almost nothing given: the configurations, rbath, rdip, the time window and deltat are found
// (README "The smallest input"). Make the data first: sh make_data.sh; then: main.out -f input_auto.jsonc (no mpirun)
// Sampled bath states: configuration.s_range (the automatic convergence takes only its presence; the number of
// states is its sampling's).
{
  "method": "cCCE", "quantity": "coherence", "order": 2,
  "Qubit": {"qubit": [{"file": "data/qubit"}], "alpha_state": {"ms": [1]}, "beta_state": {"ms": [0]}}, "configuration": {"gyrofile": "data/gyro_13C", "s_range": [1, 10], "seed": 1,
    "bathfile": ["data/config_{k}"],
    "bath_state_file": ["data/cfg{k}_state"]},
  "bfield": 500, "pulse": {"count": 1},
  "auto_convergence": {
    "workdir": "auto_found",
    "sampling": {}
  }
}
